{
  "name": "zankai-agents",
  "version": "1.0.0",
  "description": "Project setup and task coordination CLI for Codex and Antigravity",
  "type": "module",
  "scripts": {
    "zankai:init": "node scripts/team-init.mjs",
    "zankai:status": "node scripts/team-status.mjs",
    "zankai:board": "node scripts/team-board.mjs",
    "zankai:new": "node scripts/team-task.mjs new",
    "zankai:show": "node scripts/team-show.mjs",
    "zankai:task": "node scripts/team-task.mjs task",
    "zankai:assign": "node scripts/team-task.mjs assign",
    "zankai:handoff": "node scripts/team-handoff.mjs",
    "zankai:qa": "node scripts/team-qa.mjs",
    "zankai:route": "node scripts/team-route.mjs",
    "zankai:copy": "node scripts/team-copy.mjs",
    "zankai": "node bin/zankai.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zankai": "bin/zankai.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "templates/",
    "config/ai-team.json",
    ".team/roles/",
    ".team/templates/",
    "prompts/",
    "docs/INSTALLATION.md",
    ".team/ROUTING.md",
    ".team/CONVENTIONS.md",
    "docs/COMMIT_CONVENTION.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jp-pacho-ts/zankai-agents.git"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
